{
  "expo": {
    "name": "TemanPOS",
    "slug": "temanpos",
    "version": "1.2.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.temanpos.app",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "TemanPOS memakai Bluetooth untuk mencetak struk."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.temanpos.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.CAMERA",
        "android.permission.BLUETOOTH_CONNECT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "scheme": "temanpos",
    "plugins": [
      "expo-dev-client",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-font",
      "expo-screen-orientation",
      [
        "expo-camera",
        {
          "cameraPermission": "TemanPOS memakai kamera untuk scan QR toko.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "TemanPOS memakai galeri untuk foto menu dan nota.",
          "cameraPermission": "TemanPOS memakai kamera untuk scan QR toko.",
          "microphonePermission": false
        }
      ],
      "expo-sharing"
    ],
   "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "21e655fd-2edf-4de6-8445-800135858073"
      }
    },
    "owner": "fari45",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/21e655fd-2edf-4de6-8445-800135858073"
    }
  }
}
